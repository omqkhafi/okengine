{
  "name": "okengine",
  "version": "0.0.7",
  "description": "One law. Eight elements. Ten exports. One package. One manifest. Every backend need is derived, never added.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:manifest": "bun test --coverage src/manifest",
    "test:runtime": "bun test src/runtime",
    "test:compiler": "bun test src/validation src/compiler/aot src/compiler/differential",
    "bench:cold-start": "bun test src/runtime/cold-start.test.ts",
    "example": "bun ./example/bookings.ts",
    "ci": "bun run typecheck && bun run test",
    "g": "gflows"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "latest",
    "arktype": "^2.2.3",
    "gflows": "latest",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "oke": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./test": "./src/test/index.ts",
    "./config": "./src/config/index.ts",
    "./auth": "./src/auth/index.ts",
    "./drivers/*": "./src/drivers/*"
  },
  "files": [
    "src",
    "spec",
    "AGENTS.md",
    "docs/spec"
  ]
}
