{
  "name": "okengine",
  "version": "0.0.2",
  "description": "One law. Eight elements. Ten exports. One package. One manifest. Every backend need is derived, never added.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:manifest": "bun test --coverage src/manifest",
    "ci": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "bin": {
    "oke": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./test": "./src/test/index.ts",
    "./config": "./src/config/index.ts",
    "./auth": "./src/auth/index.ts",
    "./drivers/*": "./src/drivers/*"
  },
  "files": [
    "src",
    "spec",
    "AGENTS.md",
    "docs/spec"
  ]
}