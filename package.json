{
  "name": "okengine",
  "version": "0.11.2",
  "description": "One law. Eight elements. Ten exports. One package. One manifest. Every backend need is derived, never added.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omqkhafi/okengine.git"
  },
  "bin": {
    "oke": "src/cli/index.ts"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "files": [
    "src",
    "dist",
    "manifest.v1.schema.json",
    "AGENTS.md",
    "README.md",
    "site/content/docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./src/http.ts",
      "bun": "./src/http.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./kernel": {
      "types": "./src/kernel-entry.ts",
      "bun": "./src/kernel-entry.ts",
      "import": "./dist/kernel-entry.js",
      "default": "./dist/kernel-entry.js"
    },
    "./full": {
      "types": "./src/full.ts",
      "bun": "./src/full.ts",
      "import": "./dist/full.js",
      "default": "./dist/full.js"
    },
    "./i18n": {
      "types": "./src/i18n-entry.ts",
      "bun": "./src/i18n-entry.ts",
      "import": "./dist/i18n-entry.js",
      "default": "./dist/i18n-entry.js"
    },
    "./compiler": {
      "types": "./src/compiler-entry.ts",
      "bun": "./src/compiler-entry.ts",
      "import": "./dist/compiler-entry.js",
      "default": "./dist/compiler-entry.js"
    },
    "./journal": {
      "types": "./src/journal-entry.ts",
      "bun": "./src/journal-entry.ts",
      "import": "./dist/journal-entry.js",
      "default": "./dist/journal-entry.js"
    },
    "./client": "./src/client/index.ts",
    "./client/auth": "./src/client/auth.ts",
    "./client-react": "./src/client-react/index.ts",
    "./test": "./src/test/index.ts",
    "./config": "./src/config/index.ts",
    "./auth": "./src/auth/index.ts",
    "./console": "./src/console/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./store": "./src/elements/store.ts",
    "./signal": "./src/elements/signal.ts",
    "./clock": "./src/elements/clock.ts",
    "./gate": "./src/elements/gate.ts",
    "./vault": "./src/elements/vault.ts",
    "./channel": "./src/elements/channel.ts",
    "./ai": "./src/elements/ai.ts",
    "./runs": "./src/runs/index.ts",
    "./drivers": "./src/drivers/index.ts",
    "./drivers/*": "./src/drivers/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/console/tsconfig.ui-next.json && tsc --noEmit -p src/console/ui-next && bun run --cwd packages/create-oke typecheck",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "format": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:console:smoke": "bunx playwright test tests/console/smoke.spec.ts",
    "test:console:setup-ui-next": "bunx playwright test --config playwright.ui-next.config.ts",
    "build": "bunx vite build --config src/console/ui/vite.config.ts",
    "build:console-next": "bunx vite build --config src/console/ui-next/vite.config.ts",
    "dev:console-next": "bunx vite --config src/console/ui-next/vite.config.ts",
    "build:lib": "bun src/release/build-lib.ts",
    "prepack": "bun run build && bun run build:lib",
    "bench": "bun test ./src/runtime/cold-start.bench.ts src/client/budget.test.ts src/console/budget.test.ts src/kernel/budget.test.ts src/kernel/routing-budget.test.ts src/runs/bench.test.ts",
    "budgets": "bun src/release/publish.ts",
    "gate": "PUBLISH_GATE=1 bun test src/cli/doc-staleness.test.ts src/cli/competitor-mention-removal.test.ts src/drivers/vault-driver-removal.test.ts src/kernel/errors.registry.test.ts src/upgrade/codemods.test.ts scripts/publish.gate.test.ts",
    "dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "ci": "bun scripts/ci.ts",
    "bump": "bun run scripts/bump-version.ts",
    "release": "bun run scripts/publish.ts",
    "g": "gflows"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "intl-messageformat": "^11.2.13",
    "sently": "1.2.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@duckdb/node-api": "^1.5.5-r.2",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.5",
    "@oxc-project/types": "^0.142.0",
    "@playwright/test": "^1.62.1",
    "@sinclair/typebox": "^0.34.52",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-charts": "^0.9.0",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xyflow/react": "^12.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.2.3",
    "axe-core": "^4.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "gflows": "^1.2.1",
    "happy-dom": "^20.11.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mermaid": "^11.16.0",
    "motion": "^13.1.0",
    "nuqs": "^2.8.0",
    "oxc-parser": "^0.142.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^3.8.0",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": ">=3.0.0",
    "@aws-sdk/client-secrets-manager": ">=3.0.0",
    "@duckdb/node-api": ">=1.5.0",
    "@electric-sql/pglite": ">=0.5.0",
    "@electric-sql/pglite-pgvector": ">=0.0.5",
    "ajv": ">=8.0.0",
    "ajv-formats": ">=3.0.0",
    "drizzle-kit": ">=1.0.0-rc.0",
    "drizzle-orm": ">=1.0.0-rc.0",
    "drizzle-seed": ">=0.3.0",
    "oxc-parser": ">=0.140.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-pgvector": {
      "optional": true
    },
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "drizzle-seed": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "ink": "^6.0.0",
    "react": "^19.2.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
