# Environment template — copy to `.env.local` for local overrides.
#
#   cp .env.example .env.local
#
# Resolution order (first hit wins):
#   process.env → .env.local → docker/.env.docker → vault driver → dev fallback
#
# Do not commit `.env.local`. Values below are commented placeholders only.

# ── App / Console ───────────────────────────────────────────
# PORT=6530
# OKE_APP_URL=http://127.0.0.1:6530
# OKE_CONSOLE_SECRET=
# OKE_DOCKER=0
# OKE_DB_AUTO_PUSH=
# MAINTENANCE_MODE=0
# NODE_ENV=development

# ── Vault ───────────────────────────────────────────────────
# Built-in (drivers.vault: "vault"): OKE_VAULT_MASTER_KEY + SQL
# Managed AWS SM: drivers.vault "managed" + provider below
# OKE_VAULT_PROVIDER=aws-secrets-manager
# OKE_VAULT_REGION=us-east-1
# OKE_VAULT_MOUNT=oke/prod/
# OKE_VAULT_MASTER_KEY=

# ── store.sql ───────────────────────────────────────────────
# OKE_SQL_DRIVER=sqlite
# OKE_DRIZZLE_DIALECT=sqlite
# OKE_SQLITE_URL=file:.oke/app.sqlite
# OKE_LIBSQL_URL=.oke/app.libsql
# OKE_PGLITE_URL=.oke/pgdata
# DATABASE_URL=postgres://oke:password@127.0.0.1:5432/oke
# OKE_STORE_SQL_URL=postgres://oke:password@127.0.0.1:5432/oke
# OKE_STORE_SQL_USER=oke
# OKE_STORE_SQL_PASSWORD=password
# OKE_STORE_SQL_DB=oke

# ── store.kv — Redis ────────────────────────────────────────
# OKE_KV_DRIVER=memory
# REDIS_URL=redis://:password@127.0.0.1:6379
# OKE_STORE_KV_URL=redis://:password@127.0.0.1:6379
# OKE_STORE_KV_PASSWORD=password
# OKE_STORE_KV_MAXMEMORY=256mb
# OKE_STORE_KV_MAXMEMORY_POLICY=allkeys-lru

# ── store.files — S3 ────────────────────────────────────────
# OKE_FILES_DRIVER=memory
# S3_BUCKET=oke
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=access-key
# S3_SECRET_ACCESS_KEY=secret-key
# S3_REGION=us-east-1
# S3_SESSION_TOKEN=
# OKE_STORE_FILES_DB=

# ── store.index — Meilisearch / pgvector ────────────────────
# OKE_INDEX_DRIVER=memory
# OKE_STORE_INDEX_URL=http://127.0.0.1:7700
# OKE_STORE_INDEX_KEY=master-key
# MEILI_MASTER_KEY=master-key

# ── channel.email — Mailpit / SMTP ──────────────────────────
# OKE_CHANNEL_EMAIL_URL=smtp://127.0.0.1:1025
# SMTP_URL=smtp://127.0.0.1:1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAILPIT_UI_URL=http://127.0.0.1:8025
# MP_MAX_MESSAGES=500
# MP_SMTP_AUTH_ACCEPT_ANY=1
# MP_SMTP_AUTH_ALLOW_INSECURE=1

# ── channel.email — HTTP providers ──────────────────────────
# RESEND_API_KEY=
# SNDR_API_KEY=
# SNDR_BASE_URL=https://api.sndr.sh
# SNDR_FROM=hello@your-verified-domain.com
# SNDR_LIVE=0

# ── channel.sms — Taqnyat / Msegat / Unifonic ───────────────
# TAQNYAT_BEARER_TOKEN=
# TAQNYAT_TOKEN=
# TAQNYAT_SENDER=
# MSEGAT_USERNAME=
# MSEGAT_API_KEY=
# MSEGAT_SENDER=
# UNIFONIC_APPSID=
# UNIFONIC_SENDER=

# ── channel.whatsapp ────────────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── channel.push — Web Push / FCM ───────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# ── AI ──────────────────────────────────────────────────────
# Default local: llama.cpp → openai-compatible (Ollama remains supported)
# OKE_AI_DRIVER=openai-compatible
# OKE_AI_URL=http://127.0.0.1:8080/v1
# OKE_AI_MODEL=granite3.3:2b
# OLLAMA_HOST=127.0.0.1:11434
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
