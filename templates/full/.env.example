# ── Vault (app secrets — declared in src/vault.ts) ─────────────────
# create-oke copies this file to `.env.local` on scaffold (gitignored).
# Resolution: process.env → .env.local → docker/.env.docker → driver
# APP_SECRET also has a `dev:` fallback in src/vault.ts — replace for prod.
#
# On Dokploy / Railway / any host: set these in the platform env panel.
# Staging and production are two deploys — same keys, different values.
# See handbook: Get Started → Deploy.

APP_SECRET=dev-only-secret

# ── Store / channel (infrastructure — NOT required in vault.ts) ────
# Boot reads these when oke.config.ts pins postgres / redis / s3 / smtp.
# Local docker: `oke dev --docker` writes role-accurate keys into
# docker/.env.docker (Postgres USER/DB, Redis PASSWORD, S3 ACCESS_KEY/
# SECRET_KEY/BUCKET, Mailpit SMTP + UI). Leave them unset here.
# Production / staging: set the host env panel instead.

# DATABASE_URL=postgres://user:pass@host:5432/db
# REDIS_URL=redis://:pass@host:6379
# S3_ENDPOINT=http://host:9000
# S3_BUCKET=oke
# AWS_ACCESS_KEY_ID=…
# AWS_SECRET_ACCESS_KEY=…
# SMTP_URL=smtp://host:587
