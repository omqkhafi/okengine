{
  "name": "@omqkhafi/okengine",
  "version": "0.11.0",
  "description": "One law. Eight elements. Ten exports. One package. One manifest. Every backend need is derived, never added.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./test": "./src/test/index.ts",
    "./config": "./src/config/index.ts",
    "./auth": "./src/auth/index.ts",
    "./console": "./src/console/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./store": "./src/elements/store.ts",
    "./signal": "./src/elements/signal.ts",
    "./clock": "./src/elements/clock.ts",
    "./gate": "./src/elements/gate.ts",
    "./vault": "./src/elements/vault.ts",
    "./channel": "./src/elements/channel.ts",
    "./ai": "./src/elements/ai.ts",
    "./runs": "./src/runs/index.ts",
    "./drivers": "./src/drivers/index.ts"
  },
  "publish": {
    "include": [
      "src",
      "manifest.v1.schema.json",
      "AGENTS.md",
      "README.md",
      "package.json",
      "jsr.json"
    ],
    "exclude": [
      "src/console/ui/shell",
      "src/console/ui/access",
      "src/console/ui/ai",
      "src/console/ui/architecture",
      "src/console/ui/channels",
      "src/console/ui/clock",
      "src/console/ui/diff",
      "src/console/ui/flows",
      "src/console/ui/gates",
      "src/console/ui/overview",
      "src/console/ui/plugins",
      "src/console/ui/runs",
      "src/console/ui/signals",
      "src/console/ui/store",
      "src/console/ui/traces",
      "src/console/ui/vault",
      "src/console/ui/vite.config.ts",
      "src/console/ui/tsconfig.json",
      "src/console/ui/**/*.test.ts",
      "src/compiler/fixtures",
      "**/*.test.ts",
      "**/tests/**"
    ]
  }
}
