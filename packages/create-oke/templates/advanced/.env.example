# Environment template — create-oke copies this to `.env.local` when you scaffold.
#
# Resolution order (first hit wins):
#   process.env → .env.local → docker/.env.docker → vault driver → dev fallback
#
# --- Vault (app secrets) ---
# Declare secrets in src/vault.ts with `vault.secret(...)`, then uncomment lines here.
#
# ── vault — built-in encrypted-at-rest store ────────────────
# `drivers.vault` is "vault": secrets live encrypted in Postgres, no extra service.
# Nothing below is required to start — the dotenv layers above resolve first.
#
#   oke vault init                 # creates the store, prints the master key ONCE
#   export OKE_VAULT_MASTER_KEY=…  # every later command / boot unseals with this
#   oke vault status               # sealed / initialized / kek generation
#   oke vault audit                # hash-chained operation log
#
# Keep the master key out of this file in production — read it from your KMS or
# secret manager at boot. Committing it defeats encryption at rest.
# OKE_VAULT_MASTER_KEY=
#
# For `drivers.vault: "managed"` instead, point at your provider secret store:
# OKE_VAULT_PROVIDER=aws-secrets-manager
# OKE_VAULT_REGION=us-east-1
# Optional prefix for secret names (defaults to oke/<env>/):
# OKE_VAULT_MOUNT=oke/prod/
#
# --- Infrastructure ---
# Same keys as `docker/.env.docker` after `oke dev --docker`.
# Uncomment to override compose credentials for a host-managed service.
# Host ports under docker mode are unique per project — do not assume defaults.

# ── App / Console ───────────────────────────────────────────
# PORT=6530
# OKE_APP_URL=http://127.0.0.1:6530
# OKE_CONSOLE_SECRET=
# MAINTENANCE_MODE=0
# APP_WEBHOOK_SECRET=dev-webhook-secret-change-me

# ── channel.email — Mailpit (SMTP + UI) ─────────────────────
# OKE_CHANNEL_EMAIL_URL=smtp://127.0.0.1:1025
# SMTP_URL=smtp://127.0.0.1:1025
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# MAILPIT_UI_URL=http://127.0.0.1:8025
# Optional controls:
# SMTP_USER=
# SMTP_PASSWORD=
# MP_MAX_MESSAGES=500
# MP_SMTP_AUTH_ACCEPT_ANY=1
# MP_SMTP_AUTH_ALLOW_INSECURE=1

# ── channel.email — HTTP providers ──────────────────────────
# RESEND_API_KEY=
# SNDR_API_KEY=
# SNDR_BASE_URL=https://api.sndr.sh
# SNDR_FROM=hello@your-verified-domain.com

# ── channel.sms — Taqnyat / Msegat / Unifonic ───────────────
# TAQNYAT_BEARER_TOKEN=
# TAQNYAT_SENDER=
# MSEGAT_USERNAME=
# MSEGAT_API_KEY=
# MSEGAT_SENDER=
# UNIFONIC_APPSID=
# UNIFONIC_SENDER=

# ── channel.whatsapp / push ─────────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# ── store.files — object storage (S3) ───────────────────────
# OKE_STORE_FILES_URL=http://access-key:secret-key@127.0.0.1:9000/oke
# S3_ACCESS_KEY_ID=access-key
# S3_SECRET_ACCESS_KEY=secret-key
# S3_BUCKET=oke
# S3_URL=http://access-key:secret-key@127.0.0.1:9000/oke
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_CONSOLE_URL=http://127.0.0.1:9001
# S3_REGION=us-east-1
# Optional controls:
# S3_SESSION_TOKEN=

# ── store.kv — Redis ────────────────────────────────────────
# OKE_STORE_KV_PASSWORD=password
# OKE_STORE_KV_URL=redis://:password@127.0.0.1:6379
# REDIS_URL=redis://:password@127.0.0.1:6379
# Optional controls:
# OKE_STORE_KV_MAXMEMORY=256mb
# OKE_STORE_KV_MAXMEMORY_POLICY=allkeys-lru

# ── store.sql — Postgres ────────────────────────────────────
# OKE_STORE_SQL_USER=oke
# OKE_STORE_SQL_PASSWORD=password
# OKE_STORE_SQL_DB=oke
# OKE_STORE_SQL_URL=postgres://oke:password@127.0.0.1:5432/oke
# DATABASE_URL=postgres://oke:password@127.0.0.1:5432/oke
# Optional controls:
# PGDATA=/var/lib/postgresql/data/pgdata
# POSTGRES_INITDB_ARGS=--data-checksums

# ── AI ──────────────────────────────────────────────────────
# Default local: llama.cpp → openai-compatible (Ollama remains supported)
# OKE_AI_DRIVER=openai-compatible
# OKE_AI_URL=http://127.0.0.1:8080/v1
# OKE_AI_MODEL=granite3.3:2b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
