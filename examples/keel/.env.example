# Environment template for the Keel Linear-shaped example.
#
# Resolution order (first hit wins):
#   vault driver → process.env → .env.local → dev fallback
#
# ── vault — built-in encrypted-at-rest store ────────────────
#   oke vault init                 # creates the store, prints the master key ONCE
#   export OKE_VAULT_MASTER_KEY=…  # every later command / boot unseals with this
# OKE_VAULT_MASTER_KEY=

# ── App / Console ───────────────────────────────────────────
# PORT=6530
# OKE_APP_URL=http://127.0.0.1:6530
# OKE_CONSOLE_SECRET=
# PUBLIC_APP_URL=http://127.0.0.1:6530
# PUBLIC_API_URL=http://127.0.0.1:6530/api
# PUBLIC_DOCS_URL=http://127.0.0.1:3000/docs
# KEEL_WORKSPACE=keel

# ── Keel stubs (no live GitHub / Slack / OpenAI calls) ──────
# GITHUB_TOKEN=ghp_dev_keel_github_sync
# SLACK_WEBHOOK=https://hooks.slack.test/keel/cycle-digest
# SLACK_BOT=xoxb-dev-keel-intake
# WEBHOOK_SECRET=whsec_dev_keel_outbound
# OPENAI_KEY=sk-dev-keel-triage

# ── channel.email — Mailpit (SMTP + UI) ─────────────────────
# OKE_CHANNEL_EMAIL_URL=smtp://127.0.0.1:1025
# SMTP_URL=smtp://127.0.0.1:1025
# MAILPIT_UI_URL=http://127.0.0.1:8025

# ── store.files — object storage (S3) ───────────────────────
# OKE_STORE_FILES_URL=http://access-key:secret-key@127.0.0.1:9000/oke

# ── store.kv — Redis ────────────────────────────────────────
# OKE_STORE_KV_URL=redis://:password@127.0.0.1:6379
# REDIS_URL=redis://:password@127.0.0.1:6379

# ── store.sql — Postgres ────────────────────────────────────
# OKE_STORE_SQL_URL=postgres://oke:password@127.0.0.1:5432/oke
# DATABASE_URL=postgres://oke:password@127.0.0.1:5432/oke

# ── store.index — Meilisearch ───────────────────────────────
# MEILI_URL=http://127.0.0.1:7700
# MEILI_MASTER_KEY=

# ── AI (optional — triage/summarize fail Unavailable without a model) ──
# OKE_AI_DRIVER=openai-compatible
# OKE_AI_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=
