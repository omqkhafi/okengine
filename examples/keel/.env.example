# Environment template for the Keel work-management example.
#
# Resolution order (first hit wins):
#   vault driver → process.env → .env.local → dev fallback
#
# ── vault — built-in encrypted-at-rest store ────────────────
#   This example only: `oke db seed` (dev) initializes the store and writes
#   the nine keel contracts (GITHUB_TOKEN, OPENAI_KEY, SLACK_*, WEBHOOK_SECRET,
#   PUBLIC_*, KEEL_WORKSPACE). Other apps leave Vault empty.
#   oke vault init                 # seed does this; prints the master key ONCE
#   export OKE_VAULT_MASTER_KEY=…  # seed writes this into .env.local
# OKE_VAULT_MASTER_KEY=

# ── App / Console ───────────────────────────────────────────
# PORT=6530
# OKE_APP_URL=http://127.0.0.1:6530
# OKE_CONSOLE_SECRET=

# ── channel.email — Mailpit (SMTP + UI) ─────────────────────
# OKE_CHANNEL_EMAIL_URL=smtp://127.0.0.1:1025
# SMTP_URL=smtp://127.0.0.1:1025
# MAILPIT_UI_URL=http://127.0.0.1:8025

# ── store.files — object storage (S3) ───────────────────────
# OKE_STORE_FILES_URL=http://access-key:secret-key@127.0.0.1:9000/oke

# ── store.kv — Redis ────────────────────────────────────────
# OKE_STORE_KV_URL=redis://:password@127.0.0.1:6379
# REDIS_URL=redis://:password@127.0.0.1:6379

# ── store.sql — Postgres ────────────────────────────────────
# OKE_STORE_SQL_URL=postgres://oke:password@127.0.0.1:5432/oke
# DATABASE_URL=postgres://oke:password@127.0.0.1:6432/oke

# ── pgdog — connection pooler (in front of Postgres) ────────
# OKE_PGDOG_URL=postgres://oke:password@127.0.0.1:6432/oke

# ── store.index — Meilisearch ───────────────────────────────
# MEILI_URL=http://127.0.0.1:7700
# MEILI_MASTER_KEY=

# ── AI — llama.cpp (openai-compatible) ──────────────────────
# OKE_AI_DRIVER=openai-compatible
# OKE_AI_URL=
# OKE_AI_MODEL=granite3.3:2b
# OPENAI_API_KEY=
