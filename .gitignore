# dependencies (bun install)
node_modules
# anchored: an unanchored `docs` also swallows site/components/docs and
# site/content/docs, which hides real source from git and from Tailwind's
# source scanner (it skips gitignored files). Keep the canonical changelog,
# CLI reference, and specs trackable — everything else under /docs stays ignored.
/docs/**
!/docs/changelog.md
!/docs/cli.md
!/docs/spec/
!/docs/spec/**
!/docs/guides/
!/docs/guides/**
!site/content/docs/
!site/content/docs/**
!.cursor/**

# output
out
dist
# Console SPA is built into the package and must ship on npm/JSR.
!src/console/ui-next/dist/
!src/console/ui-next/dist/**
*.tgz

# docs site (Next.js) — workspace package; never keep a nested lockfile
# (Turbopack mis-detects root when site/bun.lock exists alongside the repo lock)
site/.next
site/out
site/.source
site/bun.lock
site/bun.lockb

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
docker/pgdog/

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Console / Playwright
tests/console/.claim-code
tests/console/.claim-code-ui-next
.oke/
# Accidental PGlite datadir when SQLite's `:memory:` was passed as a path
/:memory:/
playwright-report/
test-results/
blob-report/

# Local agent / implementation reports (never commit)
reports/

# Ephemeral CLI integration fixtures (e.g. src/cli/.tmp-db-mig-*)
.tmp-db-mig-*/
.claude

# Local Taqnyat scratch script (never commit)
src/plugins/__taqnyat-final.ts

# Bench artifacts (local measurements, never commit)
src/bench/results/

# Local HyperFrames compositions (promo / explainer drafts — not the product)
/video/

