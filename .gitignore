# dependencies (bun install)
node_modules
# anchored: an unanchored `docs` also swallows site/components/docs and
# site/content/docs, which hides real source from git and from Tailwind's
# source scanner (it skips gitignored files). Keep the canonical changelog
# and specs trackable — everything else under /docs stays ignored.
/docs/**
!/docs/changelog.md
!/docs/spec/
!/docs/spec/**
!site/content/docs/
!site/content/docs/**

# output
out
dist
*.tgz

# docs site (Next.js)
site/.next
site/out
site/.source

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env.stack

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Console / Playwright
tests/console/.claim-code
playwright-report/
test-results/
blob-report/