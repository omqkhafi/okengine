# dependencies (bun install)
node_modules
# anchored: an unanchored `docs` also swallows site/components/docs and
# site/content/docs, which hides real source from git and from Tailwind's
# source scanner (it skips gitignored files). Keep the canonical changelog
# and specs trackable — everything else under /docs stays ignored.
/docs/**
!/docs/changelog.md
!/docs/spec/
!/docs/spec/**
!/docs/guides/
!/docs/guides/**
!site/content/docs/
!site/content/docs/**

# output
out
dist
# Console SPA is built into the package and must ship on npm/JSR.
!src/console/ui/dist/
!src/console/ui/dist/**
*.tgz

# docs site (Next.js) — workspace package; never keep a nested lockfile
# (Turbopack mis-detects root when site/bun.lock exists alongside the repo lock)
site/.next
site/out
site/.source
site/bun.lock
site/bun.lockb

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env.docker

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Console / Playwright
tests/console/.claim-code
.oke/
playwright-report/
test-results/
blob-report/

# Local implementation reports (never commit)
reports/

# Template-local install artefacts from running template tests in-tree
templates/*/bun.lock
templates/*/bun.lockb
templates/*/node_modules/